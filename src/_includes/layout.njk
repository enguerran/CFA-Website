{%- from "icons.njk" import icon -%}
<!DOCTYPE html>
<html lang="fr">

<head>
    {% set pageTitle = title + " — " + site.name if title else site.name %}
    {% set pageDescription = description or tagline or site.tagline %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ pageTitle }}</title>

    <meta name="keywords" content="comite, fete, auzielle, cfa, village, association" />
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="robots" content="index" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:image" content="/images/icon.ico" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:type" content="website" />

    <!-- style.css scindé en 10 fichiers (voir docs/adr/0003-css-split.md) ;
         ordre de chargement identique à l'ordre du fichier d'origine, pour
         préserver la cascade CSS à l'identique (fichier "responsive" en
         dernier, comme avant). -->
    <link rel="stylesheet" href="/base.css">
    <link rel="stylesheet" href="/header.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/events.css">
    <link rel="stylesheet" href="/partners.css">
    <link rel="stylesheet" href="/about.css">
    <link rel="stylesheet" href="/contact.css">
    <link rel="stylesheet" href="/subpages.css">
    <link rel="stylesheet" href="/misc.css">
    <link rel="stylesheet" href="/responsive.css">
    <link rel="icon" href="/images/icon.ico" type="image/x-icon">
</head>

<body>
    <header>
        <a href="/" class="title">{{ site.name }}</a>
        <ul class="nav_links">
            <li><a href="/">Accueil</a></li>
            <li><a href="/#events">Évènements</a></li>
            <li><a href="/#partners">Nos partenaires</a></li>
            <li><a href="/#about">Qui sommes-nous</a></li>
            <li><a href="/#contact">Nous contacter</a></li>
        </ul>
    </header>

    <div class="header_responsive">
        <a href="/" class="title">{{ site.name }}</a>
        <i class="fa-solid fa-bars menu_hamburger">{{ icon("bars") }}</i>
    </div>

    {{ content | safe }}

    <script src="/announcement.js"></script>
    <script src="/index.js"></script>
    <script src="/contact.js"></script>
</body>

</html>
