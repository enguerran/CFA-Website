<!DOCTYPE html>
<html lang="fr">

<head>
    {% set pageTitle = title + " — " + site.name if title else site.name %}
    {% set pageDescription = description or tagline or "Le comité des fêtes...C'est pour faire la fête !!!" %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ pageTitle }}</title>

    <meta name="keywords" content="comite, fete, auzielle, cfa, village, association" />
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="robots" content="index" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:image" content="/images/icon.ico" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:type" content="website" />

    <link rel="stylesheet" href="/style.css">
    <script src="https://kit.fontawesome.com/7a0b90407e.js" crossorigin="anonymous"></script>
    <link rel="icon" href="/images/icon.ico" type="image/x-icon">

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
</head>

<body>
    <header>
        <a href="/" class="title">{{ site.name }}</a>
        <ul class="nav_links">
            <li><a href="/">Accueil</a></li>
            <li><a href="/#events">Évènements</a></li>
            <li><a href="/#partners">Nos partenaires</a></li>
            <li><a href="/#about">Qui sommes-nous</a></li>
            <li><a href="/#contact">Nous contacter</a></li>
        </ul>
    </header>

    <div class="header_responsive">
        <a href="/" class="title">{{ site.name }}</a>
        <i class="fa-solid fa-bars menu_hamburger"></i>
    </div>

    {{ content | safe }}

    <script src="/announcement.js"></script>
    <script src="/index.js"></script>
    <script src="/contact.js"></script>
</body>

</html>
