---
layout: layout.njk
---

<section id="subpages">
    <div class="head_subpage">
        <i class="fa-solid fa-circle"></i>
        <h1>{{ title }}</h1>
    </div>

    <div id="cfa-hero-announce" data-helloasso-url="{{ site.helloasso }}"></div>

    <div class="row top">
        <div class="card">
            <div class="column">
                {{ content | safe }}
                <p>{{ tagline }}</p>
                <p><em>Les informations pour la prochaine édition seront disponibles prochainement.</em></p>
                <div class="btn">
                    <a class="contactBtn" href="{{ helloasso }}" target="_blank" rel="noopener noreferrer">HelloAsso</a>
                    <a class="contactBtn" href="{{ site.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>
                    <a class="contactBtn" href="mailto:{{ site.email }}">Nous contacter</a>
                </div>
            </div>
        </div>
    </div>

    {% if extra_intro %}
    <div class="row">
        <p>{{ extra_intro }}</p>
        {% if extra_text %}<p><em>{{ extra_text }}</em></p>{% endif %}
        {% if extra_image_url %}<img src="{{ extra_image_url }}" alt="{{ extra_image_alt }}" />{% endif %}
    </div>
    {% endif %}
</section>
