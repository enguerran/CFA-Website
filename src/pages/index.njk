    </div>

    <div class="row">
        <a class="link" href="{{ site.facebook }}" target="_blank">
            <i class="fa-brands fa-facebook"></i>
            <p>Comite des Fêtes d'Auzielle</p>
        </a>
        <a class="link" href="{{ site.instagram }}" target="_blank">
            <i class="fa-brands fa-instagram"></i>
            <p>@comitedauzielle</p>
        </a>
        <a class="link" href="{{ site.tiktok }}" target="_blank">
            <i class="fa-brands fa-tiktok"></i>
            <p>@comitedauzielle</p>
        </a>
        <a class="link" href="mailto:{{ site.email }}">
            <i class="fa-solid fa-envelope"></i>
            <p>{{ site.email }}</p>
        </a>
    </div>
</section>

