---
layout: layout.njk
pagination:
  data: events
  size: 1
  alias: event
# SYNC: ce schéma d'URL doit rester identique au href codé en dur dans
# src/pages/index.njk (href="/{{ event.id }}/"). Si vous changez ce
# permalink, mettez à jour index.njk en même temps.
permalink: "/{{ event.id }}/index.html"
---

<section id="subpages">
    <div class="head_subpage">
        <i class="fa-solid fa-circle"></i>
        <h1>{{ event.title }}</h1>
    </div>

    <div id="cfa-hero-announce" data-helloasso-url="{{ site.helloasso }}"></div>

    <div class="row top">
        <div class="card">
            <div class="column">
                <p>{{ event.description }}</p>
                <p>{{ event.tagline }}</p>
                <p><em>Les informations pour la prochaine édition seront disponibles prochainement.</em></p>
                <div class="btn">
                    <a class="contactBtn" href="{{ event.helloasso }}" target="_blank" rel="noopener noreferrer">HelloAsso</a>
                    <a class="contactBtn" href="{{ site.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>
                    <a class="contactBtn" href="mailto:{{ site.email }}">Nous contacter</a>
                </div>
            </div>
        </div>
    </div>

    {% if event.extra_intro %}
    <div class="row">
        <p>{{ event.extra_intro }}</p>
        {% if event.extra_text %}<p><em>{{ event.extra_text }}</em></p>{% endif %}
        {% if event.extra_image_url %}<img src="{{ event.extra_image_url }}" alt="{{ event.extra_image_alt }}" />{% endif %}
    </div>
    {% endif %}
</section>
